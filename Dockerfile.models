FROM python:3.12-slim

ARG TORCH_INDEX=https://download.pytorch.org/whl/cu124

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/srv

WORKDIR /srv
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --index-url ${TORCH_INDEX} torch \
    && pip install --no-cache-dir \
       fastapi "uvicorn[standard]" pydantic pyyaml numpy pillow \
       FlagEmbedding sentence-transformers transformers accelerate bitsandbytes

COPY . /srv/rag
RUN useradd -m -u 10001 app \
    && chown -R app:app /srv/rag

WORKDIR /srv/rag
USER app

CMD ["python", "-m", "rag.embedding.server", "--conf", "conf/conf.docker.yaml"]
